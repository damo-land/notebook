{
  "name": "stash",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "postinstall": "npm --prefix sidecar install",
    "sidecar:install": "npm --prefix sidecar install",
    "sidecar:bundle": "npm --prefix sidecar run bundle",
    "sidecar:stage": "bash scripts/stage-sidecar-runtime.sh",
    "sidecar:package": "npm run sidecar:bundle && npm run sidecar:stage",
    "sidecar:smoke": "npm --prefix sidecar run smoke",
    "sidecar:mcp": "npm --prefix sidecar run mcp",
    "sidecar:mcp:demo": "npm --prefix sidecar run mcp:demo",
    "sidecar:enrich:demo": "npm --prefix sidecar run enrich:demo --",
    "sidecar:chat:demo": "npm --prefix sidecar run chat:demo --"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "10.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
