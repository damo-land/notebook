{
  "name": "stash-sidecar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "tsx src/main.ts",
    "smoke": "tsx src/smoke.ts",
    "mcp": "tsx src/mcp.ts",
    "mcp:demo": "tsx scripts/mcp-demo.ts",
    "enrich:demo": "tsx scripts/enrich-demo.ts",
    "chat:demo": "tsx scripts/chat-demo.ts",
    "test": "node --import tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit",
    "bundle": "esbuild src/main.ts --bundle --platform=node --format=esm --outfile=../src-tauri/resources/sidecar/sidecar-bundle.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.250",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "tsx": "^4.19.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "0.28.2",
    "typescript": "~5.8.3"
  }
}
